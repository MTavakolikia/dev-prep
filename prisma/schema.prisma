// ============================================================
// Dev Prep — Developer Operating System
// Prisma Schema (SQLite) — normalized, indexed, scalable
// NOTE: SQLite has no native enums/arrays/JSON — String fields
// hold union values & JSON payloads, typed via src/types/*.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- Identity & Access ----------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("USER") // USER | AUTHOR | EDITOR | ADMIN | SUPER_ADMIN
  avatarColor   String    @default("violet")
  headline      String?
  bio           String?
  website       String?
  github        String?
  twitter       String?
  xp            Int       @default(0)
  level         Int       @default(1)
  streakCount   Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveDay String? // yyyy-mm-dd
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions         Session[]
  articles         Article[]         @relation("ArticleAuthor")
  revisions        ArticleRevision[]
  comments         Comment[]
  likes            Like[]
  articleBookmarks ArticleBookmark[]
  questionBookmarks QuestionBookmark[]
  articleReads     ArticleRead[]
  pathItemProgress PathItemProgress[]
  enrollments      PathEnrollment[]
  attempts         InterviewAttempt[]
  achievements     UserAchievement[]
  activities       UserActivity[]
  notifications    Notification[]
  notes            Note[]
  searchHistory    SearchHistory[]
  dailyProgress    DailyProgress[]
  aiConversations  AIConversation[]
  media            Media[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------- Content Taxonomy ----------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String  @default("layers")
  color       String  @default("violet")
  sortOrder   Int     @default(0)

  technologies Technology[]
  articles     Article[]

  @@index([slug])
}

model Technology {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  description  String
  longDescription String?
  icon         String  @default("code")
  color        String  @default("violet")
  difficulty   String  @default("intermediate") // beginner|intermediate|advanced
  popularity   Int     @default(50) // 0-100 for trending
  relatedSlugs String  @default("[]") // JSON string[]
  createdAt    DateTime @default(now())

  articles          Article[]
  questions         InterviewQuestion[]
  paths             LearningPath[]
  attempts          InterviewAttempt[]
  pathItems         LearningPathItem[]

  @@index([categoryId])
  @@index([slug])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]
}

// ---------------- Articles / CMS ----------------

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String // rich HTML from Tiptap / generator
  plainText     String? // for search & reading time
  coverStyle    String    @default("violet") // gradient key
  authorId      String
  author        User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  technologyId  String?
  technology    Technology? @relation(fields: [technologyId], references: [id])
  difficulty    String    @default("beginner") // beginner|intermediate|advanced|expert
  status        String    @default("DRAFT") // DRAFT | IN_REVIEW | SCHEDULED | PUBLISHED | ARCHIVED
  readingTime   Int       @default(5)
  views         Int       @default(0)
  interviewRelevant Boolean @default(false)
  tldr          String? // JSON string[] — TL;DR bullets
  cheatSheet    String? // JSON {title, points[]} — interview cheat sheet
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  canonicalUrl  String?
  featured      Boolean   @default(false)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  revisions   ArticleRevision[]
  tags        ArticleTag[]
  comments    Comment[]
  likes       Like[]
  bookmarks   ArticleBookmark[]
  reads       ArticleRead[]
  notes       Note[]
  pathItems   LearningPathItem[]
  questions   InterviewQuestion[]

  @@index([status, publishedAt])
  @@index([technologyId, difficulty])
  @@index([authorId])
  @@index([slug])
}

model ArticleRevision {
  id             String   @id @default(cuid())
  articleId      String
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionNumber Int
  title          String
  excerpt        String
  content        String
  note           String?
  editedById     String
  editedBy       User     @relation(fields: [editedById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([articleId, revisionNumber])
  @@index([articleId])
}

model ArticleTag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ---------------- Interview Preparation ----------------

model InterviewQuestion {
  id             String   @id @default(cuid())
  question       String
  shortAnswer    String
  detailedAnswer String // rich HTML
  explanation    String?
  technologyId   String
  technology     Technology @relation(fields: [technologyId], references: [id])
  topic          String
  category       String   @default("CONCEPTUAL") // CONCEPTUAL|CODING|DEBUGGING|ARCHITECTURE|SYSTEM_DESIGN|BEHAVIORAL|PERFORMANCE|SECURITY|PRACTICAL
  difficulty     String   @default("medium") // easy|medium|hard
  seniority      String   @default("MID") // JUNIOR|MID|SENIOR|STAFF
  expectedMinutes Int     @default(5)
  companyTags    String   @default("[]") // JSON string[]
  tags           String   @default("[]") // JSON string[]
  articleId      String?
  article        Article? @relation(fields: [articleId], references: [id])
  createdAt      DateTime @default(now())

  answers InterviewAnswer[]
  bookmarks QuestionBookmark[]

  @@index([technologyId, seniority])
  @@index([category])
  @@index([topic])
}

model InterviewAttempt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           String // quick|standard|full|random|senior|staff|quiz|daily
  technologyId   String?
  technology     Technology? @relation(fields: [technologyId], references: [id])
  level          String    @default("MID") // JUNIOR|MID|SENIOR|STAFF
  title          String?
  totalQuestions Int       @default(0)
  knownCount     Int       @default(0)
  difficultCount Int       @default(0)
  skippedCount   Int       @default(0)
  score          Int       @default(0) // 0-100
  durationSeconds Int      @default(0)
  status         String    @default("IN_PROGRESS") // IN_PROGRESS|COMPLETED|ABANDONED
  strongTopics   String    @default("[]") // JSON string[]
  weakTopics     String    @default("[]") // JSON string[]
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  answers InterviewAnswer[]

  @@index([userId, createdAt])
  @@index([status])
}

model InterviewAnswer {
  id           String   @id @default(cuid())
  attemptId    String
  attempt      InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  question     InterviewQuestion @relation(fields: [questionId], references: [id])
  result       String // KNOWN | DIFFICULT | SKIPPED
  secondsSpent Int      @default(0)
  confidence   Int      @default(3) // 1-5
  sortOrder    Int      @default(0)

  @@index([attemptId])
  @@index([questionId])
}

// ---------------- Learning Paths ----------------

model LearningPath {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String
  longDescription String?
  icon           String   @default("route")
  color          String   @default("violet")
  level          String   @default("intermediate") // beginner|intermediate|advanced|expert
  estimatedHours Int      @default(20)
  technologyId   String?
  technology     Technology? @relation(fields: [technologyId], references: [id])
  careerGoal     String? // e.g. "Senior Frontend Developer"
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())

  items       LearningPathItem[]
  enrollments PathEnrollment[]

  @@index([slug])
}

model LearningPathItem {
  id             String  @id @default(cuid())
  pathId         String
  path           LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  sortOrder      Int
  title          String
  description    String?
  estimatedHours Int     @default(4)
  articleId      String?
  article        Article? @relation(fields: [articleId], references: [id])
  technologyId   String?
  technology     Technology? @relation(fields: [technologyId], references: [id])
  milestone      Boolean @default(false)

  progress PathItemProgress[]

  @@index([pathId, sortOrder])
}

model PathEnrollment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId     String
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, pathId])
  @@index([pathId])
}

model PathItemProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        LearningPathItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())

  @@unique([userId, itemId])
  @@index([itemId])
}

// ---------------- Engagement ----------------

model ArticleRead {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId  String
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  percent    Int       @default(0)
  completedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
}

model ArticleBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
}

model QuestionBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
}

model Comment {
  id        String    @id @default(cuid())
  articleId String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentThread")
  body      String
  status    String    @default("VISIBLE") // VISIBLE | HIDDEN | FLAGGED
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([articleId, status])
  @@index([userId])
}

model Note {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  highlightedText String?
  body            String
  color           String   @default("violet")
  createdAt       DateTime @default(now())

  @@index([userId, articleId])
}

// ---------------- Gamification & Activity ----------------

model Achievement {
  id          String  @id @default(cuid())
  key         String  @unique
  title       String
  description String
  icon        String  @default("award")
  tier        String  @default("bronze") // bronze|silver|gold
  xpReward    Int     @default(50)
  category    String  @default("learning") // learning|interview|streak|community|mastery

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserActivity {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String // READ_ARTICLE | COMPLETE_ARTICLE | INTERVIEW_ATTEMPT | BOOKMARK | ACHIEVEMENT | PATH_PROGRESS | STREAK | QUIZ
  refType  String? // article | question | path | achievement
  refId    String?
  title    String?
  metadata String? // JSON
  xp       Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("system") // system|article|achievement|interview|reminder
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model DailyProgress {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day                String // yyyy-mm-dd
  articlesRead       Int      @default(0)
  questionsAnswered  Int      @default(0)
  challengeCompleted Boolean  @default(false)
  xpEarned           Int      @default(0)

  @@unique([userId, day])
  @@index([day])
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query        String
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([query])
  @@index([userId])
}

// ---------------- AI Assistant ----------------

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  context   String? // JSON {articleId?, technologyId?}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  createdAt      DateTime      @default(now())

  @@index([conversationId])
}

// ---------------- Media & Analytics ----------------

model Media {
  id          String   @id @default(cuid())
  url         String
  type        String   @default("image")
  alt         String?
  size        Int?
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type])
}

model AnalyticsEvent {
  id      String   @id @default(cuid())
  type    String // page_view | article_view | search | interview_start | interview_complete | signup | bookmark | like
  day     String // yyyy-mm-dd (precomputed for fast aggregation)
  path    String?
  userId  String?
  ref     String? // technology slug etc.
  meta    String? // JSON
  createdAt DateTime @default(now())

  @@index([type, day])
  @@index([day])
}
